{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/ResQ-Route.apk",
      "destination": "https://drive.usercontent.google.com/download?id=10xREX5qFMzHCk2cRCYn7ZJUOKiuFf1nw&export=download&confirm=t",
      "permanent": false
    },
    {
      "source": "/app-debug.apk",
      "destination": "https://drive.usercontent.google.com/download?id=10xREX5qFMzHCk2cRCYn7ZJUOKiuFf1nw&export=download&confirm=t",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
